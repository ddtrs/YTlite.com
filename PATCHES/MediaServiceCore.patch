+[package]
+name = "stjson"
+version = "0.1.0"
+edition = "2021"
+description = "Fast JSON parser + JsonPath subset evaluator with JNI bindings for SmartTube"
+license = "GPL-3.0-only"
+
+# No external dependencies on purpose: builds offline and keeps the .so tiny.
+[dependencies]
+
+[lib]
+name = "stjson"
+crate-type = ["cdylib", "rlib"]
+
+[profile.release]
+opt-level = 3
+lto = true
+codegen-units = 1
+strip = true
+# NOTE: keep unwinding: JNI entry points use catch_unwind so a bug can never abort the app.
+panic = "unwind"
diff --git a/youtubeapi/rust/stjson/src/doc.rs b/youtubeapi/rust/stjson/src/doc.rs
new file mode 100644
index 0000000..2a50443
--- /dev/null
+++ b/youtubeapi/rust/stjson/src/doc.rs
@@ -0,0 +1,386 @@
+//! Zero-copy JSON document: nodes are spans into the original byte buffer.
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+#[repr(u8)]
+pub enum Kind {
+    Null = 0,
+    Bool = 1,
+    Number = 2,
+    Str = 3,
+    Array = 4,
+    Object = 5,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Node {
+    pub kind: Kind,
+    /// Str: bytes between the quotes. Number/Bool/Null: the literal text.
+    pub start: u32,
+    pub end: u32,
+    /// Str only: contains at least one backslash escape.
+    pub escaped: bool,
+    /// Array/Object: slice of `Doc::kids`.
+    pub kid_start: u32,
+    pub kid_count: u32,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Kid {
+    pub key_start: u32,
+    pub key_end: u32,
+    pub key_escaped: bool,
+    pub node: u32,
+}
+
+pub struct Doc {
+    pub data: Vec<u8>,
+    pub nodes: Vec<Node>,
+    pub kids: Vec<Kid>,
+}
+
+#[derive(Debug)]
+pub struct ParseError {
+    pub pos: usize,
+    pub msg: &'static str,
+}
+
+const MAX_DEPTH: usize = 400;
+
+pub fn parse(data: Vec<u8>) -> Result<Doc, ParseError> {
+    if data.len() >= u32::MAX as usize {
+        return Err(ParseError { pos: 0, msg: "document too large" });
+    }
+    let mut p = Parser {
+        data: &data,
+        pos: 0,
+        nodes: Vec::with_capacity(data.len() / 16 + 16),
+        kids: Vec::with_capacity(data.len() / 24 + 16),
+    };
+    // UTF-8 BOM
+    if p.data.starts_with(&[0xEF, 0xBB, 0xBF]) {
+        p.pos = 3;
+    }
+    p.skip_ws();
+    let root = p.value(0)?;
+    debug_assert_eq!(root, 0);
+    p.skip_ws();
+    if p.pos != p.data.len() {
+        return Err(p.err("trailing characters"));
+    }
+    let (nodes, kids) = (p.nodes, p.kids);
+    Ok(Doc { data, nodes, kids })
+}
+
+struct Parser<'a> {
+    data: &'a [u8],
+    pos: usize,
+    nodes: Vec<Node>,
+    kids: Vec<Kid>,
+}
+
+impl<'a> Parser<'a> {
+    fn err(&self, msg: &'static str) -> ParseError {
+        ParseError { pos: self.pos, msg }
+    }
+
+    #[inline]
+    fn skip_ws(&mut self) {
+        while let Some(&b) = self.data.get(self.pos) {
+            if b == b' ' || b == b'\n' || b == b'\r' || b == b'\t' {
+                self.pos += 1;
+            } else {
+                break;
+            }
+        }
+    }
+
+    fn push(&mut self, n: Node) -> u32 {
+        self.nodes.push(n);
+        (self.nodes.len() - 1) as u32
+    }
+
+    fn value(&mut self, depth: usize) -> Result<u32, ParseError> {
+        if depth > MAX_DEPTH {
+            return Err(self.err("nesting too deep"));
+        }
+        let b = *self.data.get(self.pos).ok_or_else(|| self.err("unexpected end"))?;
+        match b {
+            b'{' => self.object(depth),
+            b'[' => self.array(depth),
+            b'"' => {
+                let (s, e, esc) = self.string()?;
+                Ok(self.push(Node { kind: Kind::Str, start: s, end: e, escaped: esc, kid_start: 0, kid_count: 0 }))
+            }
+            b't' => self.literal(b"true", Kind::Bool),
+            b'f' => self.literal(b"false", Kind::Bool),
+            b'n' => self.literal(b"null", Kind::Null),
+            b'-' | b'0'..=b'9' => self.number(),
+            _ => Err(self.err("unexpected character")),
+        }
+    }
+
+    fn literal(&mut self, lit: &'static [u8], kind: Kind) -> Result<u32, ParseError> {
+        if self.data[self.pos..].starts_with(lit) {
+            let s = self.pos as u32;
+            self.pos += lit.len();
+            Ok(self.push(Node { kind, start: s, end: self.pos as u32, escaped: false, kid_start: 0, kid_count: 0 }))
+        } else {
+            Err(self.err("bad literal"))
+        }
+    }
+
+    fn number(&mut self) -> Result<u32, ParseError> {
+        let s = self.pos;
+        let d = self.data;
+        let mut i = self.pos;
+        if d.get(i) == Some(&b'-') {
+            i += 1;
+        }
+        match d.get(i) {
+            Some(b'0') => i += 1,
+            Some(b'1'..=b'9') => {
+                while matches!(d.get(i), Some(b'0'..=b'9')) {
+                    i += 1;
+                }
+            }
+            _ => {
+                self.pos = i;
+                return Err(self.err("bad number"));
+            }
+        }
+        if d.get(i) == Some(&b'.') {
+            i += 1;
+            if !matches!(d.get(i), Some(b'0'..=b'9')) {
+                self.pos = i;
+                return Err(self.err("bad fraction"));
+            }
+            while matches!(d.get(i), Some(b'0'..=b'9')) {
+                i += 1;
+            }
+        }
+        if matches!(d.get(i), Some(b'e') | Some(b'E')) {
+            i += 1;
+            if matches!(d.get(i), Some(b'+') | Some(b'-')) {
+                i += 1;
+            }
+            if !matches!(d.get(i), Some(b'0'..=b'9')) {
+                self.pos = i;
+                return Err(self.err("bad exponent"));
+            }
+            while matches!(d.get(i), Some(b'0'..=b'9')) {
+                i += 1;
+            }
+        }
+        self.pos = i;
+        Ok(self.push(Node { kind: Kind::Number, start: s as u32, end: i as u32, escaped: false, kid_start: 0, kid_count: 0 }))
+    }
+
+    /// Returns (start, end, has_escape) of the string body. Validates escapes.
+    fn string(&mut self) -> Result<(u32, u32, bool), ParseError> {
+        debug_assert_eq!(self.data[self.pos], b'"');
+        self.pos += 1;
+        let start = self.pos;
+        let d = self.data;
+        let mut esc = false;
+        let mut i = self.pos;
+        loop {
+            match d.get(i) {
+                None => {
+                    self.pos = i;
+                    return Err(self.err("unterminated string"));
+                }
+                Some(b'"') => break,
+                Some(b'\\') => {
+                    esc = true;
+                    match d.get(i + 1) {
+                        Some(b'"') | Some(b'\\') | Some(b'/') | Some(b'b') | Some(b'f') | Some(b'n') | Some(b'r') | Some(b't') => i += 2,
+                        Some(b'u') => {
+                            if i + 6 <= d.len() && d[i + 2..i + 6].iter().all(|c| c.is_ascii_hexdigit()) {
+                                i += 6;
+                            } else {
+                                self.pos = i;
+                                return Err(self.err("bad \\u escape"));
+                            }
+                        }
+                        _ => {
+                            self.pos = i;
+                            return Err(self.err("bad escape"));
+                        }
+                    }
+                }
+                Some(&c) if c < 0x20 => {
+                    self.pos = i;
+                    return Err(self.err("control character in string"));
+                }
+                Some(_) => i += 1,
+            }
+        }
+        self.pos = i + 1;
+        Ok((start as u32, i as u32, esc))
+    }
+
+    fn array(&mut self, depth: usize) -> Result<u32, ParseError> {
+        let id = self.push(Node { kind: Kind::Array, start: self.pos as u32, end: 0, escaped: false, kid_start: 0, kid_count: 0 });
+        self.pos += 1;
+        let mut local: Vec<Kid> = Vec::new();
+        self.skip_ws();
+        if self.data.get(self.pos) == Some(&b']') {
+            self.pos += 1;
+        } else {
+            loop {
+                self.skip_ws();
+                let n = self.value(depth + 1)?;
+                local.push(Kid { key_start: 0, key_end: 0, key_escaped: false, node: n });
+                self.skip_ws();
+                match self.data.get(self.pos) {
+                    Some(b',') => self.pos += 1,
+                    Some(b']') => {
+                        self.pos += 1;
+                        break;
+                    }
+                    _ => return Err(self.err("expected , or ]")),
+                }
+            }
+        }
+        self.finish(id, local);
+        Ok(id)
+    }
+
+    fn object(&mut self, depth: usize) -> Result<u32, ParseError> {
+        let id = self.push(Node { kind: Kind::Object, start: self.pos as u32, end: 0, escaped: false, kid_start: 0, kid_count: 0 });
+        self.pos += 1;
+        let mut local: Vec<Kid> = Vec::new();
+        self.skip_ws();
+        if self.data.get(self.pos) == Some(&b'}') {
+            self.pos += 1;
+        } else {
+            loop {
+                self.skip_ws();
+                if self.data.get(self.pos) != Some(&b'"') {
+                    return Err(self.err("expected string key"));
+                }
+                let (ks, ke, kesc) = self.string()?;
+                self.skip_ws();
+                if self.data.get(self.pos) != Some(&b':') {
+                    return Err(self.err("expected :"));
+                }
+                self.pos += 1;
+                self.skip_ws();
+                let n = self.value(depth + 1)?;
+                local.push(Kid { key_start: ks, key_end: ke, key_escaped: kesc, node: n });
+                self.skip_ws();
+                match self.data.get(self.pos) {
+                    Some(b',') => self.pos += 1,
+                    Some(b'}') => {
+                        self.pos += 1;
+                        break;
+                    }
+                    _ => return Err(self.err("expected , or }")),
+                }
+            }
+        }
+        self.finish(id, local);
+        Ok(id)
+    }
+
+    fn finish(&mut self, id: u32, local: Vec<Kid>) {
+        let n = &mut self.nodes[id as usize];
+        n.end = self.pos as u32;
+        n.kid_start = self.kids.len() as u32;
+        n.kid_count = local.len() as u32;
+        self.kids.extend(local);
+    }
+}
+
+impl Doc {
+    #[inline]
+    pub fn node(&self, id: u32) -> Option<&Node> {
+        self.nodes.get(id as usize)
+    }
+
+    pub fn kids_of(&self, n: &Node) -> &[Kid] {
+        let s = n.kid_start as usize;
+        &self.kids[s..s + n.kid_count as usize]
+    }
+
+    /// Object lookup. Duplicate keys: last one wins (same as Gson's JsonObject).
+    pub fn get_member(&self, obj: &Node, name: &str) -> Option<u32> {
+        let nb = name.as_bytes();
+        let mut found = None;
+        for k in self.kids_of(obj) {
+            let kb = &self.data[k.key_start as usize..k.key_end as usize];
+            let eq = if k.key_escaped {
+                let a = decode_utf16(kb, true);
+                a.iter().copied().eq(name.encode_utf16())
+            } else {
+                kb == nb
+            };
+            if eq {
+                found = Some(k.node);
+            }
+        }
+        found
+    }
+
+    /// Text of a Str (unescaped), Number (literal) or Bool node as UTF-16.
+    pub fn text_utf16(&self, n: &Node) -> Vec<u16> {
+        let body = &self.data[n.start as usize..n.end as usize];
+        match n.kind {
+            Kind::Str => decode_utf16(body, n.escaped),
+            _ => body.iter().map(|&b| b as u16).collect(),
+        }
+    }
+}
+
+fn hex4(b: &[u8]) -> u16 {
+    let mut v = 0u16;
+    for &c in b {
+        v = (v << 4) | (c as char).to_digit(16).unwrap() as u16;
+    }
+    v
+}
+
+/// Decode a JSON string body (already validated) into UTF-16 code units.
+/// Lone surrogates from \u escapes are preserved, exactly like Java strings.
+pub fn decode_utf16(body: &[u8], escaped: bool) -> Vec<u16> {
+    if !escaped {
+        return match std::str::from_utf8(body) {
+            Ok(s) => s.encode_utf16().collect(),
+            Err(_) => String::from_utf8_lossy(body).encode_utf16().collect(),
+        };
+    }
+    let mut out: Vec<u16> = Vec::with_capacity(body.len());
+    let mut i = 0;
+    let mut run_start = 0;
+    let flush = |out: &mut Vec<u16>, from: usize, to: usize| {
+        if to > from {
+            out.extend(String::from_utf8_lossy(&body[from..to]).encode_utf16());
+        }
+    };
+    while i < body.len() {
+        if body[i] != b'\\' {
+            i += 1;
+            continue;
+        }
+        flush(&mut out, run_start, i);
+        match body[i + 1] {
+            b'"' => out.push(b'"' as u16),
+            b'\\' => out.push(b'\\' as u16),
+            b'/' => out.push(b'/' as u16),
+            b'b' => out.push(8),
+            b'f' => out.push(12),
+            b'n' => out.push(10),
+            b'r' => out.push(13),
+            b't' => out.push(9),
+            b'u' => {
+                out.push(hex4(&body[i + 2..i + 6]));
+                i += 4;
+            }
+            _ => {}
+        }
+        i += 2;
+        run_start = i;
+    }
+    flush(&mut out, run_start, body.len());
+    out
+}
diff --git a/youtubeapi/rust/stjson/src/jni_glue.rs b/youtubeapi/rust/stjson/src/jni_glue.rs
new file mode 100644
index 0000000..642d9c6
--- /dev/null
+++ b/youtubeapi/rust/stjson/src/jni_glue.rs
@@ -0,0 +1,229 @@
+//! Minimal hand-written JNI bindings (no `jni` crate, so the build needs no network).
+//! Function-table indices are taken from the JDK's jni.h (identical on Android).
+#![allow(non_snake_case, clippy::missing_safety_doc)]
+
+use crate::doc::{self, Doc, Kind};
+use crate::path::{self, Path};
+use std::collections::HashMap;
+use std::ffi::{c_char, c_void, CStr};
+use std::panic::{catch_unwind, AssertUnwindSafe};
+use std::sync::{Mutex, RwLock};
+
+type JEnv = *mut *const *const c_void; // JNIEnv* = const struct JNINativeInterface_ **
+type JObject = *mut c_void;
+type JLong = i64;
+type JInt = i32;
+
+const IDX_NEW_STRING: usize = 163;
+const IDX_GET_STRING_UTF_CHARS: usize = 169;
+const IDX_RELEASE_STRING_UTF_CHARS: usize = 170;
+const IDX_GET_ARRAY_LENGTH: usize = 171;
+const IDX_NEW_INT_ARRAY: usize = 179;
+const IDX_GET_BYTE_ARRAY_REGION: usize = 200;
+const IDX_SET_INT_ARRAY_REGION: usize = 211;
+
+#[inline]
+unsafe fn f<T: Copy>(env: JEnv, idx: usize) -> T {
+    let table = *env;
+    let p = *table.add(idx);
+    std::mem::transmute_copy::<*const c_void, T>(&p)
+}
+
+// ---------- global path registry (compiled once, shared by all threads) ----------
+
+struct Registry {
+    paths: Vec<Path>,
+    by_text: HashMap<String, i32>,
+}
+
+static REGISTRY: RwLock<Option<Registry>> = RwLock::new(None);
+static REG_INIT: Mutex<()> = Mutex::new(());
+
+fn compile(text: &str) -> i32 {
+    {
+        if let Some(r) = REGISTRY.read().unwrap().as_ref() {
+            if let Some(&id) = r.by_text.get(text) {
+                return id;
+            }
+        }
+    }
+    let parsed = match Path::parse(text) {
+        Some(p) => p,
+        None => return -1,
+    };
+    let _g = REG_INIT.lock().unwrap();
+    let mut w = REGISTRY.write().unwrap();
+    let r = w.get_or_insert_with(|| Registry { paths: Vec::new(), by_text: HashMap::new() });
+    if let Some(&id) = r.by_text.get(text) {
+        return id;
+    }
+    let id = r.paths.len() as i32;
+    r.paths.push(parsed);
+    r.by_text.insert(text.to_string(), id);
+    id
+}
+
+fn with_path<R>(id: i32, fun: impl FnOnce(&Path) -> R) -> Option<R> {
+    let g = REGISTRY.read().unwrap();
+    let r = g.as_ref()?;
+    r.paths.get(usize::try_from(id).ok()?).map(fun)
+}
+
+unsafe fn doc_ref<'a>(h: JLong) -> Option<&'a Doc> {
+    if h == 0 {
+        None
+    } else {
+        Some(&*(h as *const Doc))
+    }
+}
+
+// ---------- exported JNI functions ----------
+// Java class: com.liskovsoft.googlecommon.common.converters.jsonpath.nativeimpl.NativeJson
+
+macro_rules! jni_name {
+    ($n:ident) => {
+        concat!("Java_com_liskovsoft_googlecommon_common_converters_jsonpath_nativeimpl_NativeJson_", stringify!($n))
+    };
+}
+
+#[export_name = jni_name!(version)]
+pub extern "system" fn version(_env: JEnv, _cls: JObject) -> JInt {
+    crate::VERSION
+}
+
+#[export_name = jni_name!(parse)]
+pub unsafe extern "system" fn parse(env: JEnv, _cls: JObject, bytes: JObject) -> JLong {
+    catch_unwind(AssertUnwindSafe(|| {
+        if bytes.is_null() {
+            return 0;
+        }
+        let len: JInt = f::<unsafe extern "system" fn(JEnv, JObject) -> JInt>(env, IDX_GET_ARRAY_LENGTH)(env, bytes);
+        if len <= 0 {
+            return 0;
+        }
+        let mut buf: Vec<u8> = vec![0u8; len as usize];
+        f::<unsafe extern "system" fn(JEnv, JObject, JInt, JInt, *mut i8)>(env, IDX_GET_BYTE_ARRAY_REGION)(
+            env,
+            bytes,
+            0,
+            len,
+            buf.as_mut_ptr() as *mut i8,
+        );
+        match doc::parse(buf) {
+            Ok(d) => Box::into_raw(Box::new(d)) as JLong,
+            Err(_) => 0,
+        }
+    }))
+    .unwrap_or(0)
+}
+
+#[export_name = jni_name!(free)]
+pub unsafe extern "system" fn free(_env: JEnv, _cls: JObject, h: JLong) {
+    if h != 0 {
+        let _ = catch_unwind(AssertUnwindSafe(|| drop(Box::from_raw(h as *mut Doc))));
+    }
+}
+
+#[export_name = jni_name!(compile)]
+pub unsafe extern "system" fn compile_jni(env: JEnv, _cls: JObject, jpath: JObject) -> JInt {
+    catch_unwind(AssertUnwindSafe(|| {
+        if jpath.is_null() {
+            return -1;
+        }
+        let chars = f::<unsafe extern "system" fn(JEnv, JObject, *mut u8) -> *const c_char>(env, IDX_GET_STRING_UTF_CHARS)(
+            env,
+            jpath,
+            std::ptr::null_mut(),
+        );
+        if chars.is_null() {
+            return -1;
+        }
+        let text = CStr::from_ptr(chars).to_string_lossy().into_owned();
+        f::<unsafe extern "system" fn(JEnv, JObject, *const c_char)>(env, IDX_RELEASE_STRING_UTF_CHARS)(env, jpath, chars);
+        compile(&text)
+    }))
+    .unwrap_or(-1)
+}
+
+#[export_name = jni_name!(isDefinite)]
+pub extern "system" fn is_definite(_env: JEnv, _cls: JObject, id: JInt) -> u8 {
+    catch_unwind(|| with_path(id, |p| p.definite).unwrap_or(false) as u8).unwrap_or(0)
+}
+
+unsafe fn new_int_array(env: JEnv, v: &[i32]) -> JObject {
+    let arr = f::<unsafe extern "system" fn(JEnv, JInt) -> JObject>(env, IDX_NEW_INT_ARRAY)(env, v.len() as JInt);
+    if !arr.is_null() && !v.is_empty() {
+        f::<unsafe extern "system" fn(JEnv, JObject, JInt, JInt, *const i32)>(env, IDX_SET_INT_ARRAY_REGION)(
+            env,
+            arr,
+            0,
+            v.len() as JInt,
+            v.as_ptr(),
+        );
+    }
+    arr
+}
+
+/// Returns null when the path is "not found"; otherwise the (possibly empty) node-id array.
+#[export_name = jni_name!(eval)]
+pub unsafe extern "system" fn eval(env: JEnv, _cls: JObject, h: JLong, node: JInt, path_id: JInt) -> JObject {
+    catch_unwind(AssertUnwindSafe(|| {
+        let d = match doc_ref(h) {
+            Some(d) => d,
+            None => return std::ptr::null_mut(),
+        };
+        let found = with_path(path_id, |p| path::eval(d, node as u32, p)).flatten();
+        match found {
+            Some(ids) => {
+                let ids: Vec<i32> = ids.into_iter().map(|x| x as i32).collect();
+                new_int_array(env, &ids)
+            }
+            None => std::ptr::null_mut(),
+        }
+    }))
+    .unwrap_or(std::ptr::null_mut())
+}
+
+#[export_name = jni_name!(kind)]
+pub unsafe extern "system" fn kind(_env: JEnv, _cls: JObject, h: JLong, node: JInt) -> JInt {
+    catch_unwind(AssertUnwindSafe(|| match doc_ref(h).and_then(|d| d.node(node as u32)) {
+        Some(n) => n.kind as JInt,
+        None => -1,
+    }))
+    .unwrap_or(-1)
+}
+
+/// Unescaped text of a string node, literal text of number/bool nodes. null otherwise.
+#[export_name = jni_name!(text)]
+pub unsafe extern "system" fn text(env: JEnv, _cls: JObject, h: JLong, node: JInt) -> JObject {
+    catch_unwind(AssertUnwindSafe(|| {
+        let d = match doc_ref(h) {
+            Some(d) => d,
+            None => return std::ptr::null_mut(),
+        };
+        let n = match d.node(node as u32) {
+            Some(n) if matches!(n.kind, Kind::Str | Kind::Number | Kind::Bool) => n,
+            _ => return std::ptr::null_mut(),
+        };
+        let u = d.text_utf16(n);
+        f::<unsafe extern "system" fn(JEnv, *const u16, JInt) -> JObject>(env, IDX_NEW_STRING)(env, u.as_ptr(), u.len() as JInt)
+    }))
+    .unwrap_or(std::ptr::null_mut())
+}
+
+#[export_name = jni_name!(children)]
+pub unsafe extern "system" fn children(env: JEnv, _cls: JObject, h: JLong, node: JInt) -> JObject {
+    catch_unwind(AssertUnwindSafe(|| {
+        let d = match doc_ref(h) {
+            Some(d) => d,
+            None => return std::ptr::null_mut(),
+        };
+        let n = match d.node(node as u32) {
+            Some(n) if n.kind == Kind::Array => n,
+            _ => return std::ptr::null_mut(),
+        };
+        let ids: Vec<i32> = d.kids_of(n).iter().map(|k| k.node as i32).collect();
+        new_int_array(env, &ids)
+    }))
+    .unwrap_or(std::ptr::null_mut())
+}
