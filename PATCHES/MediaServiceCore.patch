+++ b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/nativeimpl/NativeJson.java
@@ -0,0 +1,71 @@
+package com.liskovsoft.googlecommon.common.converters.jsonpath.nativeimpl;
+
+import android.os.Build;
+
+/**
+ * JNI bridge to the Rust "stjson" library (JSON parser + JsonPath subset).
+ * If the library cannot be loaded (unsupported ABI, API &lt; 21, stale .so) {@link #isAvailable()}
+ * is false and callers must use the pure-Java path.
+ */
+public final class NativeJson {
+    /** Must match stjson::VERSION in rust/stjson/src/lib.rs */
+    private static final int EXPECTED_VERSION = 1;
+
+    public static final int KIND_NULL = 0;
+    public static final int KIND_BOOL = 1;
+    public static final int KIND_NUMBER = 2;
+    public static final int KIND_STRING = 3;
+    public static final int KIND_ARRAY = 4;
+    public static final int KIND_OBJECT = 5;
+
+    private static final boolean sLoaded;
+    private static volatile boolean sEnabled = true;
+
+    static {
+        boolean ok = false;
+        try {
+            if (Build.VERSION.SDK_INT >= 21) { // Rust std for Android needs API 21+
+                System.loadLibrary("stjson");
+                ok = version() == EXPECTED_VERSION;
+            }
+        } catch (Throwable t) { // UnsatisfiedLinkError, SecurityException, ...
+            ok = false;
+        }
+        sLoaded = ok;
+    }
+
+    private NativeJson() {
+    }
+
+    public static boolean isAvailable() {
+        return sLoaded && sEnabled;
+    }
+
+    /** Runtime kill switch (e.g. from a debug setting). */
+    public static void setEnabled(boolean enabled) {
+        sEnabled = enabled;
+    }
+
+    private static native int version();
+
+    /** @return document handle, or 0 if the input is not strict JSON. Must be released with {@link #free}. */
+    public static native long parse(byte[] utf8);
+
+    public static native void free(long doc);
+
+    /** @return path id (>= 0) or -1 if the path is outside the supported subset. */
+    public static native int compile(String jsonPath);
+
+    public static native boolean isDefinite(int pathId);
+
+    /** @return null if "not found"; otherwise matched node ids (definite path: exactly one). */
+    public static native int[] eval(long doc, int node, int pathId);
+
+    public static native int kind(long doc, int node);
+
+    /** Unescaped string / literal number / "true"|"false". Null for other kinds. */
+    public static native String text(long doc, int node);
+
+    /** Element node ids of an array node, null for other kinds. */
+    public static native int[] children(long doc, int node);
+}
