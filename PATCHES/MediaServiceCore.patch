diff --git a/youtubeapi/rust/README.md b/youtubeapi/rust/README.md
new file mode 100644
index 0000000..2973afd
--- /dev/null
+++ b/youtubeapi/rust/README.md
@@ -0,0 +1,27 @@
+# stjson — native JSON for SmartTube
+
+Replaces the slowest part of response parsing: `JsonPathTypeAdapter` used to re-serialize
+(`toString()`) and re-parse every nested object, and evaluate JsonPath through reflection on
+every object. Now the body is parsed **once** in Rust (zero-copy, spans into the byte buffer)
+and Java walks nodes by id.
+
+* `stjson/` — dependency-free Rust crate (parser, JsonPath subset, hand-written JNI).
+* `build-android.sh` — builds `libstjson.so` for armeabi-v7a / arm64-v8a / x86 / x86_64 into
+  `src/main/rustLibs/` (Gradle packages it automatically; `buildRustJson` runs it if
+  `ANDROID_NDK_HOME` is set).
+
+## Safety net (why it can't make things worse)
+The Java side falls back to the original Jayway code when: the library is missing/stale, API < 21,
+the body is not strict JSON, a path is outside the supported subset, or anything unusual shows up.
+Kill switch: `NativeJson.setEnabled(false)`.
+
+## Build
+```
+export ANDROID_NDK_HOME=/path/to/ndk/26.x     # r23+ required by Rust's libunwind linkage
+rust/build-android.sh                          # or just run ./gradlew assemble...
+```
+Host tests: `cd stjson && ST_CORPUS=../../src/test/resources cargo test --release`
+
+## Supported JsonPath subset
+`$`, `.name`, `['name']`, `[n]`, `[*]`, `[a:]`, `[:b]`, `[a:b]` — all 491 paths currently used in
+the app. Semantics follow Jayway 2.4 (missing leaf => not found/empty, etc.).
diff --git a/youtubeapi/rust/build-android.sh b/youtubeapi/rust/build-android.sh
new file mode 100755
index 0000000..288d217
--- /dev/null
+++ b/youtubeapi/rust/build-android.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+# Builds libstjson.so for the Android ABIs SmartTube ships and drops them into
+# youtubeapi/src/main/rustLibs/<abi>/ (picked up by Gradle as extra jniLibs).
+#
+# Requirements: rustup/cargo, Android NDK r23 or newer (older NDKs lack libunwind that Rust links).
+#   export ANDROID_NDK_HOME=/path/to/ndk/26.x
+# Usage: rust/build-android.sh [abi ...]      (default: armeabi-v7a arm64-v8a x86 x86_64)
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+CRATE="$HERE/stjson"
+OUT="$HERE/../src/main/rustLibs"
+API=21 # Rust's std for Android needs API 21+. Older devices fall back to the Java parser automatically.
+
+NDK="${ANDROID_NDK_HOME:-${ANDROID_NDK_ROOT:-}}"
+[ -n "$NDK" ] && [ -d "$NDK" ] || { echo "Set ANDROID_NDK_HOME to an NDK r23+ directory" >&2; exit 1; }
+case "$(uname -s)" in Linux) HOST=linux-x86_64;; Darwin) HOST=darwin-x86_64;; *) HOST=windows-x86_64;; esac
+BIN="$NDK/toolchains/llvm/prebuilt/$HOST/bin"
+[ -d "$BIN" ] || { echo "NDK toolchain not found: $BIN" >&2; exit 1; }
+
+ABIS=("$@"); [ ${#ABIS[@]} -gt 0 ] || ABIS=(armeabi-v7a arm64-v8a x86 x86_64)
+
+for abi in "${ABIS[@]}"; do
+  case "$abi" in
+    armeabi-v7a) T=armv7-linux-androideabi;  CC="armv7a-linux-androideabi$API-clang";;
+    arm64-v8a)   T=aarch64-linux-android;    CC="aarch64-linux-android$API-clang";;
+    x86)         T=i686-linux-android;       CC="i686-linux-android$API-clang";;
+    x86_64)      T=x86_64-linux-android;     CC="x86_64-linux-android$API-clang";;
+    *) echo "unknown abi $abi" >&2; exit 1;;
+  esac
+  rustup target add "$T" >/dev/null
+  U="$(echo "$T" | tr 'a-z-' 'A-Z_')"
+  export "CARGO_TARGET_${U}_LINKER=$BIN/$CC"
+  # force eager symbol binding: a missing libc symbol fails at load time (-> Java fallback), not mid-call
+  export "CARGO_TARGET_${U}_RUSTFLAGS=-C link-arg=-Wl,-z,now -C link-arg=-Wl,-z,max-page-size=16384"
+  echo ">> $abi ($T)"
+  cargo build --release --manifest-path "$CRATE/Cargo.toml" --target "$T"
+  mkdir -p "$OUT/$abi"
+  cp "$CRATE/target/$T/release/libstjson.so" "$OUT/$abi/libstjson.so"
+done
+echo "done -> $OUT"
