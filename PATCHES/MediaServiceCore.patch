+//! stjson: fast JSON parsing + JsonPath subset for SmartTube (JNI).
+pub mod doc;
+pub mod path;
+mod jni_glue;
+
+/// Bump together with `NativeJson.EXPECTED_VERSION` on the Java side.
+pub const VERSION: i32 = 1;
diff --git a/youtubeapi/rust/stjson/src/path.rs b/youtubeapi/rust/stjson/src/path.rs
new file mode 100644
index 0000000..8f4d878
--- /dev/null
+++ b/youtubeapi/rust/stjson/src/path.rs
@@ -0,0 +1,162 @@
+//! Tiny JsonPath subset: `$`, `.name`, `['name']`, `[n]`, `[*]`, `[a:]`, `[:b]`, `[a:b]`.
+//!
+//! Semantics intentionally mirror Jayway JsonPath 2.4 with the Gson provider and default
+//! options, as used by SmartTube's `JsonPathTypeAdapter`:
+//!  * definite path (only names / single indexes): no match -> "not found" (Java: PathNotFoundException)
+//!  * indefinite path (`[*]`, slices): returns the (possibly empty) list of matches,
+//!    but a type mismatch / missing non-leaf property while every previous token was
+//!    definite is still "not found".
+//! Anything outside the subset is rejected by `Path::parse`, so Java can fall back to Jayway.
+
+use crate::doc::{Doc, Kind};
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum Token {
+    Prop(String),
+    Index(usize),
+    Wildcard,
+    Slice(usize, Option<usize>),
+}
+
+impl Token {
+    fn definite(&self) -> bool {
+        matches!(self, Token::Prop(_) | Token::Index(_))
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct Path {
+    pub tokens: Vec<Token>,
+    pub definite: bool,
+}
+
+impl Path {
+    pub fn parse(s: &str) -> Option<Path> {
+        let b = s.as_bytes();
+        if b.first() != Some(&b'$') {
+            return None;
+        }
+        let mut i = 1;
+        let mut tokens = Vec::new();
+        while i < b.len() {
+            match b[i] {
+                b'.' => {
+                    i += 1;
+                    let st = i;
+                    while i < b.len() && b[i] != b'.' && b[i] != b'[' {
+                        i += 1;
+                    }
+                    let name = &s[st..i];
+                    if name.is_empty()
+                        || !name.chars().all(|c| c.is_alphanumeric() || c == '_' || c == '$' || c == '-')
+                    {
+                        return None; // "..", ".*", functions, filters, spaces, ...
+                    }
+                    tokens.push(Token::Prop(name.to_string()));
+                }
+                b'[' => {
+                    let end = s[i..].find(']')? + i;
+                    let inner = &s[i + 1..end];
+                    i = end + 1;
+                    if inner == "*" {
+                        tokens.push(Token::Wildcard);
+                    } else if let Some(q) = inner.strip_prefix('\'').and_then(|r| r.strip_suffix('\'')) {
+                        if q.is_empty() || q.contains('\'') || q.contains('\\') {
+                            return None;
+                        }
+                        tokens.push(Token::Prop(q.to_string()));
+                    } else if let Some(q) = inner.strip_prefix('"').and_then(|r| r.strip_suffix('"')) {
+                        if q.is_empty() || q.contains('"') || q.contains('\\') {
+                            return None;
+                        }
+                        tokens.push(Token::Prop(q.to_string()));
+                    } else if let Some((a, c)) = inner.split_once(':') {
+                        let a = if a.is_empty() { 0 } else { a.parse::<usize>().ok()? };
+                        let c = if c.is_empty() { None } else { Some(c.parse::<usize>().ok()?) };
+                        if !inner.bytes().all(|x| x.is_ascii_digit() || x == b':') {
+                            return None;
+                        }
+                        tokens.push(Token::Slice(a, c));
+                    } else if !inner.is_empty() && inner.bytes().all(|x| x.is_ascii_digit()) {
+                        tokens.push(Token::Index(inner.parse().ok()?));
+                    } else {
+                        return None; // negative index, unions, filters, expressions
+                    }
+                }
+                _ => return None,
+            }
+        }
+        let definite = tokens.iter().all(|t| t.definite());
+        Some(Path { tokens, definite })
+    }
+}
+
+/// `None` = not found. `Some(nodes)` = matches (definite paths: exactly one node).
+pub fn eval(doc: &Doc, root: u32, path: &Path) -> Option<Vec<u32>> {
+    let mut cur: Vec<u32> = vec![root];
+    let mut upstream_definite = true;
+    let last = path.tokens.len().saturating_sub(1);
+
+    for (ti, tok) in path.tokens.iter().enumerate() {
+        let leaf = ti == last;
+        let mut next: Vec<u32> = Vec::new();
+        for &mid in &cur {
+            let model = doc.node(mid)?;
+            match tok {
+                Token::Prop(name) => {
+                    if model.kind != Kind::Object {
+                        if upstream_definite {
+                            return None;
+                        }
+                        continue;
+                    }
+                    match doc.get_member(model, name) {
+                        Some(v) => next.push(v),
+                        None => {
+                            // leaf: silently no result; non-leaf: error only if fully definite so far
+                            if !leaf && upstream_definite {
+                                return None;
+                            }
+                        }
+                    }
+                }
+                Token::Index(_) | Token::Wildcard | Token::Slice(..) => {
+                    if model.kind != Kind::Array {
+                        if upstream_definite {
+                            return None;
+                        }
+                        continue;
+                    }
+                    let kids = doc.kids_of(model);
+                    match tok {
+                        Token::Index(n) => {
+                            if let Some(k) = kids.get(*n) {
+                                next.push(k.node);
+                            }
+                        }
+                        Token::Wildcard => next.extend(kids.iter().map(|k| k.node)),
+                        Token::Slice(a, b) => {
+                            let to = b.map_or(kids.len(), |b| b.min(kids.len()));
+                            if *a < to {
+                                next.extend(kids[*a..to].iter().map(|k| k.node));
+                            }
+                        }
+                        Token::Prop(_) => unreachable!(),
+                    }
+                }
+            }
+        }
+        upstream_definite &= tok.definite();
+        cur = next;
+    }
+
+    if path.definite {
+        if cur.is_empty() {
+            None
+        } else {
+            Some(vec![*cur.last().unwrap()])
+        }
+    } else {
+        Some(cur)
+    }
+}
diff --git a/youtubeapi/rust/stjson/tests/corpus.rs b/youtubeapi/rust/stjson/tests/corpus.rs
new file mode 100644
index 0000000..dc8c8d9
--- /dev/null
+++ b/youtubeapi/rust/stjson/tests/corpus.rs
@@ -0,0 +1,78 @@
+use std::fs;
+use std::path::{Path as FsPath, PathBuf};
+use stjson::doc::{self, Kind};
+use stjson::path::{eval, Path};
+
+fn walk(dir: &FsPath, out: &mut Vec<PathBuf>) {
+    if let Ok(rd) = fs::read_dir(dir) {
+        for e in rd.flatten() {
+            let p = e.path();
+            if p.is_dir() { walk(&p, out) } else if p.extension().map_or(false, |x| x == "json") { out.push(p) }
+        }
+    }
+}
+
+#[test]
+fn parses_real_youtube_responses() {
+    let root = std::env::var("ST_CORPUS").unwrap_or_else(|_| "../../src/test/resources".into());
+    let mut files = Vec::new();
+    walk(FsPath::new(&root), &mut files);
+    assert!(!files.is_empty(), "no corpus found at {root}");
+    let (mut ok, mut skipped) = (0, 0);
+    for f in &files {
+        let data = fs::read(f).unwrap();
+        // some fixtures are not strict JSON (e.g. ")]}'" prefix, query strings): skip those, as Java falls back
+        match doc::parse(data.clone()) {
+            Ok(d) => {
+                ok += 1;
+                // every string node must decode without panic
+                for n in &d.nodes { if n.kind == Kind::Str { let _ = d.text_utf16(n); } }
+            }
+            Err(e) => { skipped += 1; eprintln!("skip {}: {:?}", f.display(), e); }
+        }
+    }
+    eprintln!("parsed {ok}, skipped {skipped} of {}", files.len());
+    assert!(ok > files.len() / 2);
+}
+
+#[test]
+fn escapes_and_surrogates() {
+    let d = doc::parse(br#"{"a":"x\u00e9\ud83d\ude00\n\"q\"","a\u0062":1}"#.to_vec()).unwrap();
+    let n = d.nodes[1];
+    let s = String::from_utf16(&d.text_utf16(&n)).unwrap();
+    assert_eq!(s, "x\u{e9}\u{1F600}\n\"q\"");
+    assert!(d.get_member(&d.nodes[0], "ab").is_some()); // escaped key
+}
+
+#[test]
+fn duplicate_key_last_wins() {
+    let d = doc::parse(br#"{"k":1,"k":2}"#.to_vec()).unwrap();
+    let id = d.get_member(&d.nodes[0], "k").unwrap();
+    assert_eq!(d.text_utf16(d.node(id).unwrap()), vec![b'2' as u16]);
+}
+
+#[test]
+fn path_semantics() {
+    let d = doc::parse(br#"{"a":{"b":[{"c":1},{"c":2},{"x":3}]},"n":null,"s":"t","arr":[10,20,30]}"#.to_vec()).unwrap();
+    let ev = |p: &str| eval(&d, 0, &Path::parse(p).unwrap());
+    assert_eq!(ev("$.a.b[*].c").unwrap().len(), 2);   // wildcard: missing leaf skipped
+    assert_eq!(ev("$.a.b[2].c"), None);               // definite leaf missing -> not found
+    assert_eq!(ev("$.a.zz[*]"), None);                // missing non-leaf, upstream definite -> error
+    assert_eq!(ev("$.a.b[*].q.w").unwrap().len(), 0); // indefinite upstream: silent
+    assert_eq!(ev("$.arr[1:]").unwrap().len(), 2);
+    assert_eq!(ev("$.arr[5:]").unwrap().len(), 0);
+    assert_eq!(ev("$.arr[9]"), None);
+    assert_eq!(ev("$.s[*]"), None);                   // wildcard on string, upstream definite
+    assert!(ev("$.n").is_some());                     // explicit null is a found value
+    assert_eq!(ev("$").unwrap(), vec![0]);
+    for bad in ["$..a", "$.a[?(@.x)]", "$[-1]", "$.a[0,1]", "a.b", "$.a.*"] {
+        assert!(Path::parse(bad).is_none(), "{bad}");
+    }
+}
+
+#[test]
+fn rejects_malformed() {
+    for bad in ["", "{", "[1,]", "{\"a\":}", "01", "1.", "\"\\x\"", "nul", "[1] x"] {
+        assert!(doc::parse(bad.as_bytes().to_vec()).is_err(), "{bad:?}");
+    }
+}
