+import com.jayway.jsonpath.ParseContext;
+import com.jayway.jsonpath.PathNotFoundException;
+import com.liskovsoft.googlecommon.common.converters.jsonpath.JsonPathObj;
+import com.liskovsoft.sharedutils.helpers.Helpers;
+import com.liskovsoft.sharedutils.mylogger.Log;
+import com.liskovsoft.googlecommon.common.converters.jsonpath.JsonPath;
+import com.liskovsoft.googlecommon.common.helpers.ReflectionHelper;
+import com.liskovsoft.googlecommon.common.converters.jsonpath.nativeimpl.NativeJson;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.lang.annotation.Annotation;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.lang.reflect.Type;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class JsonPathTypeAdapter<T> {
+    private static final String TAG = JsonPathTypeAdapter.class.getSimpleName();
+    private final ParseContext mParser;
+    private final Class<?> mType;
+    /** Reflection results are computed once per class (was: on every parsed object). */
+    private static final ConcurrentHashMap<Class<?>, ClassMeta> sMetaCache = new ConcurrentHashMap<>();
+    /** Root types that hit something the native path cannot handle. They go straight to Jayway. */
+    private static final Set<Class<?>> sNativeBlacklist =
+            java.util.Collections.newSetFromMap(new ConcurrentHashMap<Class<?>, Boolean>());
+
+    public JsonPathTypeAdapter(ParseContext parser, Class<?> type) {
+        mParser = parser;
+        mType = type;
+    }
+
+    public JsonPathTypeAdapter(ParseContext parser, Type type) {
+        mParser = parser;
+        mType = (Class<?>) type;
+    }
+
+    @SuppressWarnings("unchecked")
+    public final T read(InputStream is) {
+        is = process(is);
+
+        if (!NativeJson.isAvailable() || sNativeBlacklist.contains(mType)) {
+            return readLegacy(is);
+        }
+
+        byte[] data = readAll(is);
+
+        if (data == null) {
+            return null; // same as Helpers.toString(): IO error -> null content
+        }
+
+        try {
+            return (T) readNative(data);
+        } catch (NativeFailure e) {
+            // Not strict JSON, unsupported path, exotic case etc. Use the proven Jayway path.
+            return readLegacy(new ByteArrayInputStream(data));
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private T readLegacy(InputStream is) {
+
+        String jsonContent = null;
+
+        String[] jsonPath = getJsonPath(getGenericType());
+
+        if (jsonPath != null) { // annotation on the same collection class
+            DocumentContext parser = mParser.parse(is);
+            for (String path : jsonPath) {
+                try {
+                    jsonContent = parser.read(path).toString();
+                    break;
+                } catch (PathNotFoundException e) {
+                    Log.e(TAG, e.getMessage());
+                }
+            }
+        } else { // annotation on field
+            jsonContent = Helpers.toString(is);
+        }
+
+        T result = (T) readType(getGenericType(), jsonContent);
+
+        //if (result == null) {
+        //    // Dump root object
+        //    ReflectionHelper.dumpDebugInfo(getGenericType(), jsonContent);
+        //}
+
+        return result;
+    }
+
+    /**
+     * Enable additional processing like skipping first line etc
+     */
+    protected InputStream process(InputStream is) {
+        return is;
+    }
+
+    private Class<?> getGenericType() {
+        return mType;
+    }
+
+    private Object readType(Class<?> type, String jsonContent) {
+        if (type == null || jsonContent == null) {
+            return null;
+        }
+
+        Object obj = null;
+        boolean done = false;
+
+        try {
+            Constructor<?> constructor = type.getConstructor();
+            obj = constructor.newInstance();
+
+            DocumentContext parser = mParser.parse(jsonContent);
+
+            for (FieldMeta meta : getMeta(type).fields) {
+                boolean result = processField(meta, obj, type, parser);
+
+                // At least one field is set
+                if (result) {
+                    done = true;
+                }
+            }
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
+
+        return done ? obj : null;
+    }
+
+    private boolean processField(FieldMeta meta, Object obj, Class<?> type, DocumentContext parser) {
+        //Log.d(TAG, "Processing on thread: %s", Thread.currentThread().getName());
+
+        boolean done = false;
+        Field field = meta.field;
+        String[] jsonPath = meta.paths;
+
+        Object jsonVal = null;
+
+        for (String path : jsonPath) {
+            try {
+                jsonVal = parser.read(path);
+                break;
+            } catch (PathNotFoundException e) {
+                Log.d(TAG, type.getSimpleName() + ": Path not found: " + path);
+            }
+        }
+
+        if (jsonVal == null) {
+            return false;
+        }
+
+        try {
+            if (JsonPathObj.class.isAssignableFrom(field.getType())) {
+                Object val = readType(field.getType(), jsonVal.toString());
+                field.set(obj, val);
+            } else if (jsonVal instanceof JsonArray) {
+                List<Object> list = null;
+                Class<?> myType = ReflectionHelper.getGenericParamType(field);
+
+                if (myType == null) {
+                    Log.e(TAG, "Please, supply generic field for the list type: " + field);
+                    return false;
+                }
+
+                for (Object jsonObj : (JsonArray) jsonVal) {
+                    Object item;
+
+                    if (jsonObj instanceof JsonPrimitive) {
+                        item = parsePrimitive((JsonPrimitive) jsonObj);
+                    } else {
+                        item = readType(myType, jsonObj.toString());
+                    }
+
+                    if (item != null) {
+                        if (list == null) {
+                            list = new ArrayList<>();
+                        }
+
+                        list.add(item);
+                    }
+                }
+
+                field.set(obj, list);
+            } else if (jsonVal instanceof JsonPrimitive) {
+                Object val = parsePrimitive((JsonPrimitive) jsonVal);
+
+                field.set(obj, val);
+            } else if (jsonVal instanceof JsonObject) {
+                Object val = readType(field.getType(), jsonVal.toString());
+                field.set(obj, val);
+            }
+
+            done = field.get(obj) != null; // field is set
+        } catch (IllegalArgumentException e) {
+            Log.d(TAG, "%s: Incompatible json value found %s. Same path on different types?", field.getType().getSimpleName(), jsonVal);
+        } catch (IllegalAccessException e) {
+            Log.d(TAG, "%s: Illegal access with value %s.", field.getType().getSimpleName(), jsonVal);
+        }
+
+        return done;
+    }
+
+    private String[] getJsonPath(Class<?> type) {
+        Annotation[] annotations = type.getAnnotations();
+
+        return getJsonPath(annotations);
+    }
+
+    private String[] getJsonPath(Field field) {
+        Annotation[] annotations = field.getAnnotations();
+
+        return getJsonPath(annotations);
+    }
+
+    private String[] getJsonPath(Annotation[] annotations) {
+        for (Annotation annotation : annotations) {
+            if (annotation instanceof JsonPath) {
+                return ((JsonPath) annotation).value();
+            }
+        }
+
+        return null;
+    }
+
+    private Object parsePrimitive(JsonPrimitive jsonVal) {
+        Object val;
+
+        if (jsonVal.isNumber()) {
+            if (jsonVal.toString().contains(".")) {
+                val = jsonVal.getAsFloat(); // Float
+            } else {
+                val = jsonVal.getAsInt(); // Integer
+            }
+        } else if (jsonVal.isBoolean()) {
+            val = jsonVal.getAsBoolean(); // Boolean
+        } else {
+            val = jsonVal.getAsString(); // String
+        }
+
+        return val;
+    }
+
+    // ------------------------------------------------------------------------------------
+    // Reflection cache
+    // ------------------------------------------------------------------------------------
+
+    private static final class FieldMeta {
+        final Field field;
+        final String[] paths;
+        /** Native path ids, resolved lazily; -1 = unsupported by the native evaluator. */
+        volatile int[] pathIds;
+        volatile boolean listTypeResolved;
+        volatile Class<?> listType;
+        final boolean jsonPathObj;
+
+        FieldMeta(Field field, String[] paths) {
+            this.field = field;
+            this.paths = paths;
+            this.jsonPathObj = JsonPathObj.class.isAssignableFrom(field.getType());
+        }
+
+        Class<?> listType() {
+            if (!listTypeResolved) {
+                // may throw ClassCastException exactly like the original code did; nothing cached then
+                listType = ReflectionHelper.getGenericParamType(field);
+                listTypeResolved = true;
+            }
+            return listType;
+        }
+    }
+
+    private static final class ClassMeta {
+        final FieldMeta[] fields;
+        volatile int nativeState; // 0 unknown, 1 all paths supported, -1 some unsupported
+
+        ClassMeta(FieldMeta[] fields) {
+            this.fields = fields;
+        }
+    }
+
+    private static ClassMeta getMeta(Class<?> type) {
+        ClassMeta meta = sMetaCache.get(type);
+
+        if (meta == null) {
+            List<FieldMeta> result = new ArrayList<>();
+
+            for (Field field : ReflectionHelper.getAllFields(type)) {
+                String[] paths = getFieldPaths(field);
+
+                if (paths != null) {
+                    field.setAccessible(true);
+                    result.add(new FieldMeta(field, paths));
+                }
+            }
+
+            meta = new ClassMeta(result.toArray(new FieldMeta[0]));
+            ClassMeta prev = sMetaCache.putIfAbsent(type, meta);
+
+            if (prev != null) {
+                meta = prev;
+            }
+        }
+
+        return meta;
+    }
+
+    private static String[] getFieldPaths(Field field) {
+        for (Annotation annotation : field.getAnnotations()) {
+            if (annotation instanceof JsonPath) {
+                return ((JsonPath) annotation).value();
+            }
+        }
+
+        return null;
+    }
+
+    // ------------------------------------------------------------------------------------
+    // Native (Rust) fast path: the body is parsed ONCE; nested objects are addressed by node id
+    // instead of being serialized to a String and parsed again on every level.
+    // ------------------------------------------------------------------------------------
+
+    /** Internal signal: abandon native parsing and redo everything with Jayway. */
+    private static final class NativeFailure extends RuntimeException {
+        NativeFailure() {
+            super(null, null, false, false); // no stack trace: used as control flow
+        }
+    }
+
+    private static byte[] readAll(InputStream is) {
+        try {
+            ByteArrayOutputStream out = new ByteArrayOutputStream(32 * 1024);
+            byte[] buf = new byte[16 * 1024];
+            int n;
+
+            while ((n = is.read(buf)) != -1) {
+                out.write(buf, 0, n);
+            }
+
+            return out.toByteArray();
+        } catch (IOException e) {
+            e.printStackTrace();
+            Log.e(TAG, e.getMessage());
+        }
+
+        return null;
+    }
+
+    private Object readNative(byte[] data) {
+        long doc = NativeJson.parse(data);
+
+        if (doc == 0) {
+            throw new NativeFailure(); // empty / not strict JSON: let Jayway decide what to do
+        }
+
+        try {
+            int rootNode = 0;
+            String[] classPaths = getJsonPath(getGenericType());
+
+            if (classPaths != null) { // annotation on the same collection class
+                int[] ids = resolvePaths(classPaths);
+                boolean found = false;
+
+                for (int id : ids) {
+                    int[] hit = NativeJson.eval(doc, 0, id);
+
+                    if (hit == null) {
+                        continue;
+                    }
+
+                    // Indefinite path / null value: original code stringifies a synthetic array. Rare: use Jayway.
+                    if (!NativeJson.isDefinite(id) || hit.length != 1 || NativeJson.kind(doc, hit[0]) == NativeJson.KIND_NULL) {
+                        throw new NativeFailure();
+                    }
+
+                    rootNode = hit[0];
+                    found = true;
+                    break;
+                }
+
+                if (!found) {
+                    return null; // original: jsonContent stays null -> null
+                }
+            }
+
+            Object result = readTypeNative(getGenericType(), doc, rootNode);
+
+            return result;
+        } catch (NativeFailure e) {
+            sNativeBlacklist.add(mType);
+            throw e;
+        } finally {
+            NativeJson.free(doc);
+        }
+    }
+
+    private static int[] resolvePaths(String[] paths) {
+        int[] ids = new int[paths.length];
+
+        for (int i = 0; i < paths.length; i++) {
+            ids[i] = NativeJson.compile(paths[i]);
+
+            if (ids[i] < 0) {
+                throw new NativeFailure();
+            }
+        }
+
+        return ids;
+    }
+
+    private static int[] getPathIds(FieldMeta meta) {
+        int[] ids = meta.pathIds;
+
+        if (ids == null) {
+            ids = resolvePaths(meta.paths);
+            meta.pathIds = ids;
+        }
+
+        return ids;
+    }
+
+    private Object readTypeNative(Class<?> type, long doc, int node) {
+        if (type == null) {
+            return null;
+        }
+
+        Object obj = null;
+        boolean done = false;
+
+        try {
+            ClassMeta meta = getMeta(type);
+
+            if (meta.nativeState == 0) {
+                try {
+                    for (FieldMeta f : meta.fields) {
+                        getPathIds(f);
+                    }
+                    meta.nativeState = 1;
+                } catch (NativeFailure e) {
+                    meta.nativeState = -1;
+                }
+            }
+
+            if (meta.nativeState < 0) {
+                throw new NativeFailure();
+            }
+
+            Constructor<?> constructor = type.getConstructor();
+            obj = constructor.newInstance();
+
+            for (FieldMeta f : meta.fields) {
+                if (processFieldNative(f, obj, type, doc, node)) {
+                    done = true; // at least one field is set
+                }
+            }
+        } catch (NativeFailure e) {
+            throw e;
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
+
+        return done ? obj : null;
+    }
+
+    private boolean processFieldNative(FieldMeta meta, Object obj, Class<?> type, long doc, int node) {
+        Field field = meta.field;
+        int[] ids = getPathIds(meta);
+        int[] hit = null;
+        boolean definite = false;
+
+        for (int id : ids) {
+            hit = NativeJson.eval(doc, node, id);
+
+            if (hit != null) {
+                definite = NativeJson.isDefinite(id);
+                break;
+            }
+            // else: path not found, try the next one (no exception thrown/logged here)
+        }
+
+        if (hit == null) {
+            return false;
+        }
+
+        int[] elements; // non-null when the value is a list of nodes
+        int valueNode = -1;
+        int kind = -1;
+
+        if (definite) {
+            valueNode = hit[0];
+            kind = NativeJson.kind(doc, valueNode);
+
+            if (kind == NativeJson.KIND_NULL) {
+                return false; // JSON null: field stays unset
+            }
+
+            elements = kind == NativeJson.KIND_ARRAY ? NativeJson.children(doc, valueNode) : null;
+        } else {
+            elements = hit; // [*] / slice: list of matches (possibly empty)
+        }
+
+        try {
+            if (meta.jsonPathObj) {
+                if (elements != null && !definite) {
+                    throw new NativeFailure(); // original would re-parse a synthetic array here
+                }
+
+                field.set(obj, readTypeNative(field.getType(), doc, valueNode));
+            } else if (elements != null) {
+                List<Object> list = null;
+                Class<?> myType = meta.listType();
+
+                if (myType == null) {
+                    Log.e(TAG, "Please, supply generic field for the list type: " + field);
+                    return false;
+                }
+
+                for (int el : elements) {
+                    int elKind = NativeJson.kind(doc, el);
+                    Object item;
+
+                    if (elKind == NativeJson.KIND_NULL) {
+                        continue; // original: readType("null") -> null -> skipped
+                    } else if (elKind == NativeJson.KIND_OBJECT || elKind == NativeJson.KIND_ARRAY) {
+                        item = readTypeNative(myType, doc, el);
+                    } else {
+                        item = parsePrimitiveNative(elKind, NativeJson.text(doc, el));
+                    }
+
+                    if (item != null) {
+                        if (list == null) {
+                            list = new ArrayList<>();
+                        }
+
+                        list.add(item);
+                    }
+                }
+
+                field.set(obj, list);
+            } else if (kind == NativeJson.KIND_OBJECT) {
+                field.set(obj, readTypeNative(field.getType(), doc, valueNode));
+            } else {
+                field.set(obj, parsePrimitiveNative(kind, NativeJson.text(doc, valueNode)));
+            }
+
+            return field.get(obj) != null; // field is set
+        } catch (IllegalArgumentException e) {
+            Log.d(TAG, "%s: Incompatible json value found. Same path on different types?", field.getType().getSimpleName());
+        } catch (IllegalAccessException e) {
+            Log.d(TAG, "%s: Illegal access.", field.getType().getSimpleName());
+        }
+
+        return false;
+    }
+
+    /** Same results as {@link #parsePrimitive(JsonPrimitive)} (Gson LazilyParsedNumber rules). */
+    private static Object parsePrimitiveNative(int kind, String text) {
+        if (text == null) {
+            return null;
+        }
+
+        if (kind == NativeJson.KIND_NUMBER) {
+            if (text.contains(".")) {
+                return Float.parseFloat(text);
+            }
+
+            try {
+                return Integer.parseInt(text);
+            } catch (NumberFormatException e) {
+                try {
+                    return (int) Long.parseLong(text);
+                } catch (NumberFormatException e2) {
+                    return new java.math.BigDecimal(text).intValue();
+                }
+            }
+        } else if (kind == NativeJson.KIND_BOOL) {
+            return Boolean.valueOf(text);
+        }
+
+        return text; // string
+    }
+}
